# Sync server (apps/server)
PORT=4111
HOST=0.0.0.0
# SQLite file for document history. The directory is created on start.
DATABASE_PATH=./data/chalkline.db
# Serve the built web app from this directory (used by the Docker image).
# Leave empty in development, where Vite serves the app on port 4110.
STATIC_DIR=
# Comma-separated list of allowed Origin headers for WebSocket upgrades.
# Empty means any origin.
ALLOWED_ORIGINS=
# Rows in the update log before a room is compacted into a single snapshot.
COMPACT_AFTER_UPDATES=200
# How long incoming updates are buffered before being written as one row.
FLUSH_INTERVAL_MS=500
# How long an empty room stays in memory before it is compacted and unloaded.
IDLE_UNLOAD_MS=30000
MAX_CONNECTIONS_PER_ROOM=64
MAX_MESSAGE_BYTES=8388608
LOG_LEVEL=info

# Web app (apps/web)
# Override the sync endpoint. Defaults to the page origin, which works for both
# the Vite dev proxy and the single-container deployment.
VITE_SYNC_URL=
